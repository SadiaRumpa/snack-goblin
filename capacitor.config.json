{
  "appId": "com.sadiarumpa.snackgoblin",
  "appName": "Snack Goblin",
  "webDir": "docs",
  "bundledWebRuntime": false,
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#1a1a2e",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "overlaysWebView": true,
      "backgroundColor": "#1a1a2e"
    }
  }
}
